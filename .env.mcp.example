# Deployment template for compose.mcp.yaml. No owner/admin DB accounts.
# cp .env.mcp.example .env.mcp; fill passwords and secrets locally.
# The database host is the service name on the Backend Docker network.
BACKEND_NETWORK=backend_default
BUSINESS_DATABASE_URL=postgresql+asyncpg://mro_business_reader:REPLACE_PASSWORD@postgres:5432/mro
RAG_DATABASE_URL=postgresql+asyncpg://mro_reader:REPLACE_PASSWORD@postgres:5432/mro
BUSINESS_SOURCE_VERSION=backend-seed
# At least 32 random characters each, distinct. The two JWT secrets must match the Backend issuer:
#   BUSINESS_JWT_SECRET = Backend mro.mcp.business-jwt-secret (env MCP_BUSINESS_JWT_SECRET)
#   RAG_JWT_SECRET      = Backend mro.mcp.rag-jwt-secret      (env MCP_RAG_JWT_SECRET)
# Backend local profile defaults (local only): local-business-mcp-secret-0123456789abcdef /
# local-rag-mcp-secret-0123456789abcdef01234. Reader passwords default to local-business-reader-only /
# local-reader-only in Backend docker-compose.
BUSINESS_JWT_SECRET=
RAG_JWT_SECRET=
RAG_CURSOR_SECRET=
# R02 하이브리드 검색용 OpenAI 키 (질의 임베딩만, 1회 약 $0.000003). 비우면 단어 검색만 합니다.
RAG_OPENAI_API_KEY=
