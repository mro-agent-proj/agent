# Local development only. Copy to .env and set real random secrets; never commit .env.
DATABASE_URL=postgresql+asyncpg://mro_owner:local-dev-only@127.0.0.1:55432/mro
# Server must use a separate SELECT-only account (see docs/RUNBOOK.md).
RAG_DATABASE_URL=postgresql+asyncpg://mro_reader:local-reader-only@127.0.0.1:55432/mro
RAG_JWT_SECRET=replace-with-at-least-32-random-characters
RAG_CURSOR_SECRET=replace-with-another-32-random-characters
RAG_HOST=127.0.0.1
RAG_PORT=8102
MRO_SOURCE_DIR=data/source/airbus-mcp-data-v1
HF_HOME=artifacts/huggingface
MRO_EMBED_DEVICE=cpu
# business-mcp (B01~B03) on the backend's shared DB; SELECT-only account from backend Flyway V4.
BUSINESS_DATABASE_URL=postgresql+asyncpg://mro_business_reader:local-business-reader-only@127.0.0.1:5432/mro
BUSINESS_HOST=127.0.0.1
BUSINESS_PORT=8101
